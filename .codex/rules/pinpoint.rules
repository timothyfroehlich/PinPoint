# PinPoint-local Codex permissions. This file is loaded only when the repository's
# .codex layer is trusted. Keep external publication and destructive operations
# review-gated; allow the routine development lifecycle inside this repository.

# Routine Git mutations for user-authorized PinPoint development. Commit, push,
# branch creation, and merge run through a fixed-interface wrapper so
# later-positioned flags cannot smuggle in discards, --no-verify, force-push
# behavior, or another merge target.
prefix_rule(pattern=["git", "add"], decision="allow", justification="Stage PinPoint changes for the current task")
prefix_rule(
    pattern=["bash", "scripts/workflow/codex-git.sh"],
    decision="allow",
    justification="Run a validated PinPoint commit, current-branch push, or origin/main merge",
    match=[
        "bash scripts/workflow/codex-git.sh commit 'fix(workflow): validate git mutations'",
        "bash scripts/workflow/codex-git.sh push",
        "bash scripts/workflow/codex-git.sh branch codex/example",
        "bash scripts/workflow/codex-git.sh merge-main",
    ],
)
# Stop this worktree's own Next.js server; the script refuses any other process.
prefix_rule(
    pattern=["pnpm", "run", "dev:stop"],
    decision="allow",
    justification="Stop only the Next.js server on this worktree's PORT whose cwd is this worktree",
    match=["pnpm run dev:stop", "pnpm run dev:stop --dry-run"],
)
prefix_rule(pattern=["git", "stash", "push"], decision="allow", justification="Temporarily preserve PinPoint working-tree changes")
prefix_rule(pattern=["git", "stash", "apply"], decision="allow", justification="Restore preserved PinPoint changes without deleting the stash")
prefix_rule(pattern=["git", "stash", "pop"], decision="allow", justification="Restore preserved PinPoint changes")

# Raw forms always prompt because prefix rules cannot constrain arbitrary suffixes.
# Use codex-git.sh for the frictionless safe path.
prefix_rule(
    pattern=["git", "commit"],
    decision="prompt",
    justification="Use bash scripts/workflow/codex-git.sh commit <message>; raw commit flags require approval",
    match=[
        "git commit -m safe",
        "git commit --no-verify -m bypass",
        "git commit -m bypass --no-verify",
        "git commit --amend -m rewrite",
    ],
)
prefix_rule(
    pattern=["git", "push"],
    decision="prompt",
    justification="Use bash scripts/workflow/codex-git.sh push; raw push flags require approval",
    match=[
        "git push",
        "git push origin --no-verify feature",
        "git push origin --force main",
        "git push --mirror origin",
    ],
)
prefix_rule(
    pattern=["git", "merge"],
    decision="prompt",
    justification="Use bash scripts/workflow/codex-git.sh merge-main; raw merge targets or flags require approval",
    match=[
        "git merge origin/main",
        "git merge origin/main --no-verify",
    ],
)
prefix_rule(
    pattern=["git", ["checkout", "switch"]],
    decision="prompt",
    justification="Use bash scripts/workflow/codex-git.sh branch codex/<name>; raw checkout/switch flags can discard changes",
    match=[
        "git checkout -b topic HEAD~1 --force",
        "git switch -c topic HEAD~1 --discard-changes",
    ],
)
prefix_rule(pattern=["git", "worktree", "add"], decision="prompt", justification="Worktree creation paths and force flags require approval")

# Discards, branch deletion, and manual worktree teardown.
prefix_rule(pattern=["git", "reset"], decision="prompt", justification="Reset can discard commits or working-tree changes")
prefix_rule(pattern=["git", "clean"], decision="prompt", justification="Clean can permanently delete untracked files")
prefix_rule(pattern=["git", "restore"], decision="prompt", justification="Restore can discard working-tree changes")
prefix_rule(pattern=["git", "checkout", "--"], decision="prompt", justification="Checkout with a path can discard working-tree changes")
prefix_rule(pattern=["git", "branch", "-d"], decision="prompt", justification="Deleting a branch requires confirmation")
prefix_rule(pattern=["git", "branch", "-D"], decision="prompt", justification="Force-deleting a branch requires confirmation")
prefix_rule(pattern=["git", "worktree", "remove"], decision="prompt", justification="Use scripts/worktree_cleanup.py so worktree resources are released safely")
prefix_rule(pattern=["git", "worktree", "prune"], decision="prompt", justification="Pruning worktree metadata requires confirmation")
prefix_rule(pattern=["git", "stash", "drop"], decision="prompt", justification="Dropping a stash deletes preserved changes")
prefix_rule(pattern=["git", "stash", "clear"], decision="prompt", justification="Clearing stashes deletes all preserved changes")

# GitHub CLI. Read-only PR and run subcommands are approval-free. GitHub's
# ruleset enforces the merge gates; `gh pr merge` prompts because prefix rules
# cannot deny a later `--admin` flag, so a human stays in the loop. PR checkouts
# strand a worktree on a throwaway branch, so they are forbidden. Every other gh
# command falls through to the default approval policy.
prefix_rule(
    pattern=["gh", "pr", ["list", "view", "checks", "diff"]],
    decision="allow",
    justification="Read PinPoint pull request state",
    match=["gh pr list --limit 20", "gh pr view 2058 --json headRefOid", "gh pr checks 2058", "gh pr diff 2058"],
)
prefix_rule(
    pattern=["gh", "run", ["list", "view"]],
    decision="allow",
    justification="Read PinPoint CI runs",
    match=["gh run list --limit 20", "gh run view 12345"],
)
prefix_rule(
    pattern=["gh", "pr", "merge"],
    decision="prompt",
    justification="After Tim's explicit merge request: gh pr merge <PR> --squash or --auto --squash; never --admin",
    match=["gh pr merge 2058 --squash", "gh pr merge 2058 --auto --squash", "gh pr merge 2058 --admin --squash"],
)
prefix_rule(
    pattern=["gh", "pr", "update-branch"],
    decision="allow",
    justification="Merges main into the PR branch; never --rebase",
    match=["gh pr update-branch 2058"],
)
prefix_rule(
    pattern=["gh", "pr", ["checkout", "co"]],
    decision="forbidden",
    justification="gh pr checkout switches this worktree onto a throwaway branch; use gh pr diff/view, or git worktree add",
    match=["gh pr checkout 2058", "gh pr co 2058"],
)
prefix_rule(pattern=["gh", "co"], decision="forbidden", justification="gh co is gh pr checkout; use gh pr diff/view, or git worktree add")
# Trusted PinPoint workflow entry points and routine local validation.
prefix_rule(pattern=["./scripts/workflow/pr-watch.py"], decision="allow", justification="Monitor a PinPoint pull request through the repository workflow")
prefix_rule(pattern=["python3", "scripts/workflow/pr-watch.py"], decision="allow", justification="Monitor a PinPoint pull request through the repository workflow")
prefix_rule(pattern=["bash", "scripts/workflow/approve-ui.sh"], decision="allow", justification="Record Tim's own UI approval (chat or artifact click) on the PR head; never approve the ui-approval environment through the raw API")
prefix_rule(pattern=["pnpm", "run", "check"], decision="allow", justification="Run PinPoint's static quality gate")
prefix_rule(pattern=["pnpm", "run", "check:python"], decision="allow", justification="Run PinPoint's Python quality gate")
prefix_rule(pattern=["pnpm", "run", "test"], decision="allow", justification="Run PinPoint's unit test suite")
prefix_rule(pattern=["pnpm", "run", "preflight"], decision="allow", justification="Run PinPoint's preflight gate")
