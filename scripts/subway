#!/usr/bin/env bash
# Subway: Under-the-playfield token shunting via Gemini Flash
# Usage:
#   scripts/subway read --question "<question>" --paths <file1> [<file2> ...]
#   scripts/subway write --spec "<spec>" --reference <ref_file> [--target <out_file>]
#   scripts/subway ask "<prompt>"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKER_PY="${SCRIPT_DIR}/lib/gemini_worker.py"

show_help() {
  cat << 'EOF'
Subway — Under-the-playfield token routing via Gemini Flash

Usage:
  scripts/subway read  --question "<question>" --paths <file1> [<file2> ...]
  scripts/subway write --spec "<spec>" --reference <ref-file> [--target <out-file>]
  scripts/subway ask   "<prompt>"

Commands:
  read   Bulk-read files out-of-band and return structured summary bullets
  write  Generate boilerplate code matching pattern file directly to disk
  ask    Send a direct prompt to Gemini Flash

Options:
  --help, -h   Show this help message
EOF
}

if [[ $# -eq 0 ]]; then
  show_help
  exit 1
fi

command="$1"
shift

case "$command" in
  read)
    exec "${SCRIPT_DIR}/bulk-read" "$@"
    ;;
  write)
    exec "${SCRIPT_DIR}/code-write" "$@"
    ;;
  ask)
    if [[ $# -eq 0 ]]; then
      echo "Error: prompt text required for ask" >&2
      exit 1
    fi
    exec python3 "${WORKER_PY}" --prompt "$1"
    ;;
  -h|--help|help)
    show_help
    exit 0
    ;;
  *)
    echo "Error: unknown command '$command'" >&2
    show_help >&2
    exit 1
    ;;
esac
