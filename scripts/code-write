#!/usr/bin/env bash
# Delegate boilerplate generation to Gemini Flash code-writer mode
# Usage: scripts/code-write --spec "write tests for UserService" --reference ref.test.ts [--target out.test.ts]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKER_PY="${SCRIPT_DIR}/lib/gemini_worker.py"

spec=""
reference=""
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec)
      spec="$2"
      shift 2
      ;;
    --reference)
      reference="$2"
      shift 2
      ;;
    --target)
      target="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [[ -z "$spec" ]]; then
  echo "Error: --spec is required" >&2
  echo "Usage: scripts/code-write --spec \"<what to generate>\" --reference <ref-file> [--target <out-file>]" >&2
  exit 1
fi

if [[ -z "$reference" ]]; then
  echo "Error: --reference is required — pass a file whose patterns the output should match." >&2
  exit 1
fi

if [[ ! -f "$reference" || ! -r "$reference" ]]; then
  echo "Error: reference file not found or unreadable: $reference" >&2
  exit 1
fi

tmp_prompt="$(mktemp)"
tmp_output="$(mktemp)"
trap 'rm -f "${tmp_prompt}" "${tmp_output}"' EXIT

{
  printf 'Spec: %s\n\n' "$spec"
  printf 'Reference pattern file (%s):\n' "$reference"
  cat "$reference"
} > "${tmp_prompt}"

SYSTEM_INSTRUCTION="You generate code files based on a spec and reference files. Match the existing patterns, conventions, naming, and style exactly. Output only the code — no explanations, no markdown fences unless asked. If the spec is ambiguous, make reasonable choices that match the patterns in the reference code."

python3 "${WORKER_PY}" \
  --prompt-file "${tmp_prompt}" \
  --system-instruction "${SYSTEM_INSTRUCTION}" \
  --temperature 0.2 > "${tmp_output}"

# Strip markdown code fences if model wrapped the code
clean=$(sed -E '/^```[a-zA-Z0-9_-]*$/d' "${tmp_output}")

if [[ -n "$target" ]]; then
  target_dir="$(dirname "$target")"
  mkdir -p "$target_dir"
  printf '%s\n' "$clean" > "$target"
  lines=$(wc -l < "$target" | tr -d ' ')
  echo "Wrote ${lines} lines to ${target}" >&2
else
  printf '%s\n' "$clean"
fi
