{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TypeScript: Check",
      "type": "shell",
      "command": "mise",
      "args": ["exec", "--", "pnpm", "run", "typecheck"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$tsc"],
      "detail": "Check TypeScript compilation without errors"
    },
    {
      "label": "Build Project",
      "type": "shell",
      "command": "mise",
      "args": ["exec", "--", "pnpm", "run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$tsc"],
      "detail": "Build the Next.js project"
