{
  "permissions": {
    "allow": [
      "Bash(bash scripts/workflow/mark-review.sh *)",
      "Bash(bash scripts/workflow/review-preflight.sh *)"
    ],
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(supabase projects delete:*)",
      "Bash(supabase stop --all)",
      "Bash(supabase stop --all *)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)"
    ],
    "ask": [
      "Bash(*merge-pr.sh*--force*)",
      "Bash(*merge-pr.sh*--bypass-merge-requirements*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase db remote commit:*)",
      "Bash(supabase migration repair:*)",
      "Bash(supabase branches delete:*)",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__claude_ai_Supabase__restore_project",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__claude_ai_Supabase__delete_branch",
      "mcp__claude_ai_Supabase__merge_branch",
      "mcp__claude_ai_Supabase__rebase_branch",
      "mcp__claude_ai_Supabase__reset_branch",
      "Bash(rm -rf:*)",
      "Bash(rm -fr *)",
      "Bash(docker rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(kill:*)",
      "Bash(xargs kill:*)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard)",
      "Bash(git -C * reset --hard *)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git branch -D *)",
      "Bash(git -C * branch -D *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git -C * push --force)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git -C * push -f *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/inject-beads-actor.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/block-direct-merge.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/block-main-worktree-branch-switch.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/block-worktree-dispatch-from-linked.cjs",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.agents/huddle/huddle-main-watch.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/preflight-reminder.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ui-screenshot-reminder.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.agents/huddle/huddle-pr-announce.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HUDDLE_THROTTLE_SECONDS=180 bash \"$HOME\"/.agents/huddle/huddle-poll.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/worktree-create.sh",
            "timeout": 180000
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/worktree_cleanup.py\" --claude-hook",
            "timeout": 60000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.agents/huddle/huddle-poll.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/prototype-mode-poll.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.agents/huddle/huddle-session-start.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/session-start-orphan-sweep.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/prototype-mode-poll.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/verify-guard-stack.cjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/session-start-chores-nag.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true
  },
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  }
}
